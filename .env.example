# Copy to .env.local — use the same values as ShortJapan / nextLotto
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Merriam-Webster Learner's Dictionary (server-only, from dictionaryapi.com)
MERRIAM_WEBSTER_API_KEY=your-learners-api-key

# Web Push (free VAPID) — do not commit private key
# Generate: node scripts/generate-vapid.mjs
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
PUSH_CRON_SECRET=change-me-to-a-long-random-string
CRON_SECRET=change-me-to-a-long-random-string
