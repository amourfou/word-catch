# Copy to .env.local — use the same values as ShortJapan / nextLotto
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Merriam-Webster Learner's Dictionary (server-only, from dictionaryapi.com)
MERRIAM_WEBSTER_API_KEY=your-learners-api-key

# Web Push (free VAPID) — do not commit private key
# Generate: node scripts/generate-vapid.mjs
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
PUSH_CRON_SECRET=change-me-to-a-long-random-string
CRON_SECRET=change-me-to-a-long-random-string

# In-process push scheduler (personal long-running Node only).
# Vercel: false / unset  — UI + subscribe only
# Personal server (`pnpm start`): true  — WordCatch due reminders only
PUSH_SCHEDULER_ENABLED=false

# --- Security (server-only, never NEXT_PUBLIC_) ---
# Service role key: Supabase Dashboard → Project Settings → API Keys. Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=
# 32+ random chars, e.g. `openssl rand -base64 32`. Signs the login cookie.
SESSION_SECRET=
# Public self sign-up (true/false). Default off: admins add users and set PINs.
ALLOW_PUBLIC_SIGNUP=false
